{
  "name": "yixian-overlay",
  "version": "0.1.0",
  "description": "Minimal overlay card counter for YiXianPai (separate project)",
  "main": "main.js",
  "scripts": {
    "start": "cross-env ELECTRON_RUN_AS_NODE= electron .",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac zip --publish never",
    "dist:win": "electron-builder --win nsis zip --publish never"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@leeoniya/ufuzzy": "1.0.14",
    "chokidar": "^3.6.0",
    "seedrandom": "^3.0.5"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^25.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.raymondwang.yixian-overlay",
    "productName": "Yixian Overlay",
    "asar": true,
    "files": [
      "**/*",
      "!card detector{,/**}",
      "!vendor/yisim-master{,/**}",
      "!images{,/**}",
      "!data{,/**}",
      "!debug{,/**}",
      "!overlay_settings.json",
      "!ConvertedHandCard.json",
      "!ConvertedCardOperationLog.json",
      "!game_screenshot.png",
      "!startup.log",
      "!todo",
      "!dist{,/**}",
      "!.github{,/**}"
    ],
    "extraResources": [
      {
        "from": "images",
        "to": "images",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "data",
        "to": "data",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/yisim-master",
        "to": "vendor/yisim-master",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "identity": null,
      "category": "public.app-category.utilities",
      "target": [
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    }
  }
}
